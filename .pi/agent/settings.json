{
  "lastChangelogVersion": "1.5.2",
  "theme": "dark",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.2-sol",
  "packages": [
    "npm:@plannotator/pi-extension",
    {
      "source": "git:github.com/DietrichGebert/ponytail",
      "skills": [
        "!skills/ponytail-audit/**",
        "!skills/ponytail-debt/**",
        "!skills/ponytail-gain/**",
        "!skills/ponytail-help/**"
      ]
    },
    "https://github.com/earendil-works/pi-claude-code"
  ],
  "skills": [
    "-~/.agents/skills/plannotator/SKILL.md",
    "-~/.agents/skills/plannotator-annotate/SKILL.md",
    "-~/.agents/skills/plannotator-inbox/SKILL.md",
    "-~/.agents/skills/plannotator-last/SKILL.md"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "enableInstallTelemetry": false,
  "defaultThinkingLevel": "medium"
}